{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "declaration": true,

    "noEmitOnError": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
