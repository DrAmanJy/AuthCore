{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
