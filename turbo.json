{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "test": {
      "outputs": []
    },

    "test:watch": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "clean": {
      "cache": false
    }
  }
}
